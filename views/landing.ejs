<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Fly-in Friends</title>
  <link rel="stylesheet" href="/styles/landing.css">
</head>
<body>

    <section class="hero">
        <div class="container">
            <h2>Meet Locals in Dublin and skip the tourist traps</h2>
            
            <p>
                Fly-in Freinds helps tourists coming to Dublin meet local people,
                explore the city, and find someone to split their first G with.
            </p>
            <a href="/login" class="button">Sign up</a>

        </div>

        <!-- Guinness Image -->
    <img src="../styles/Guinness.png" class="guinness-img">


    </section>

    <section id="about" class="section">
        <div class="container">
            <h2> About Fly-in Friends</h2>
            <p>
                Fly-in Friends is for helping  travellers meet Dublin locals.
                Instead of doing everything alone, visitors can connect  with friendly locals 
                and enjoy a real Dublin experience.

            </p>

        </div>

    </section>

    <section id="how" class="lightGreen-section">
        <div class="container">
            <h2>How it works</h2>

            <div class="card-container">
                <div class="card">

                <h3>✈️ 1. Sign Up</h3>
                <p>Travellers and locals join the website </p>

                </div>

                <div class="card">
                    <h3>🤝 2. Connect with locals</h3>
                    <p> We help match travellers with local people who know the city well.</p>

                </div>

                <div class="card">
                    <h3>🗺️ 3. Explore Dublin</h3>
                    <p>They can meet up, explore local spots, and enjoy Dublin together.</p>

                </div>

            </div>

        </div>

    </section>

  <section class="section">
  <div class="molly-container">

    <div class="why-text">
      <h2>Why Use Fly-in Friends?</h2>
      <ul>
        <li>👥 Meet real local people</li>
        <li>📍 Discover hidden places in Dublin</li>
        <li>🧭 Feel less alone when travelling</li>
        <li>🍻 Have a better first day in the city</li>
      </ul>
    </div>

    <img src="../styles/Molly.png" class="Molly-img" alt="Molly Malone Statue">

  </div>
</section>

  <section id="join" class="section join-section">
    <div class="container">
      <h2>Ready to make friends in Dublin?</h2>
      <p>Join Fly-in Friends and start your trip with a local welcome.</p>
      <a href="/login" class="button">Sign Up</a>
    </div>
  </section>

  <footer class="footer">
    <div class="container">
      <p>☘️Fly-in Friends</p>
    </div>
  </footer>

</body>
</html>



  



  
