<!DOCTYPE html>
<html>
<head>
    <title>Hangout Listings</title>
    <link rel="stylesheet" href="/styles/listings.css">
    <link rel="stylesheet" href="/styles/styles.css">
</head>

<body>

    <%- include("partials/navbar"); %>

    <div class="page-container">

        <h1 class="main-title">Fly-in Friends ✈️</h1>

        <div class="nav-links">
            <a href="/map">Map</a>
            <span>|</span>
            <a href="/chat-page">Messages</a>
        </div>

        <!-- ADD LISTING -->
        <div class="add-listing-card">
            <h2>Add Your Own Listing 📍</h2>

            <form action="/add-listing" method="POST" class="add-listing-form">
                <input type="text" name="title" placeholder="Hangout title" required>
                <input type="text" name="location" placeholder="Eircode or location (e.g. D24 WD00, Tallaght)" required>
                <input type="text" name="activity" placeholder="Activity" required>
                <button type="submit">Add Listing</button>
            </form>
        </div>

        <!-- LISTINGS -->
        <h2 class="section-title">Available Hangouts 📍</h2>

        <% listings.forEach(listing => { %>
            <div class="listing">
                <h3><%= listing.title %></h3>
                <p><strong>Location:</strong> <%= listing.location %></p>
                <p><strong>Activity:</strong> <%= listing.activity %></p>
            </div>
        <% }) %>

    </div>

    <%- include("partials/footer"); %>

</body>
</html>
