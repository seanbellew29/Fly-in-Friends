<!DOCTYPE html>
<html>
<head>
    <title>Map</title>
    <link rel="stylesheet" href="/styles/map.css">
    <link rel="stylesheet" href="/styles/styles.css">
    <link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css"/>
    <script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>
</head>
<body>

    <%- include("partials/navbar"); %>

    <h1>Fly-in Friends</h1>

    <div class="split-view">
        <!-- puts hangouts on the right and map on left-->
        <div id="map"></div>

        <div id="listings-container">
            <h2>Available Hangouts</h2>

            <% listings.forEach(listing => { %>
                <div class="listing">
                    <h3>📍<%= listing.title %></h3>
                    <p><strong>Location:</strong> <%= listing.location %></p>
                    <p><strong>Activity:</strong> <%= listing.activity %></p>
                </div>
            <% }) %>
        </div>
    </div>

    <%- include("partials/footer"); %>
    <!-- makes the data from the server into browser javascript
     so it can be used to generate map markers -->
    <script>
    window.listings = <%- JSON.stringify(listings || []) %>;
</script>
<script src="/scripts/aScript.js"></script>
</body>
</html>