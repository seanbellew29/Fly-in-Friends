<!DOCTYPE html>
<html lang = "en">
    <head>
        <meta charset="UTF-8">
        <title>Login</title>
        <link rel="Stylesheet" href="styles.css">
    </head>

    <body>

        <%- include("partials/navbar"); %>

        <div class="container">

            <!--login card on left-->
        <div class="login-card">
            <div class="icon">plane here</div>
            <h2>Welcome again!</h2>
            <p>Please Enter your details</p>

            <!--Form-->
            <form action="/login" method="POST">

                <!--Email-->
                <div class="input-group">
                    <lable>Email</lable>
                    <input type="email" name="email" required>

                </div>

                <!--Password-->
                <div class="input-group">
                    <lable>Password</lable>
                    <div class="password-wrapper">
                        <input type="password" name="password" id="password" required>
                        <span id="togglePassword">eye ball here </span>

                    </div>
                </div>

                <!--Role-->
                <div class="options">
                    <div>
                        <input type="radio" name="role" value="Traveler" required> Traveler 
                        <input type="radio" name="role" value="Local" required> Local            
                   </div>
                    <a href="/forgot-password">Forgot Password ?</a>

                </div>

                <!--Login Button-->
                <button type="submit" class="login-btn">Log in</button>


            </form>

        </div>
        <!--Right side image area-->
        <div class="image-side">
            <img src="../styles/login.png" alt="Travelers">

        </div>

        </div>

        <script>
            const toggle = document.getElementById("togglePassword");
            const password = document.getElementById("password");

            if(toggle && password){
                toggle.addEventListener("click",()=>{
                    password.type =
                    password.type === "password"? "text" : "password";
                });
                
            }

        </script>

    </body>
</html>