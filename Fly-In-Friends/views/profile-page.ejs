<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Profile</title>
    <link rel="stylesheet" href="/styles/styles.css">
    <link rel="stylesheet" href="/styles/profile-page.css">
    <link rel="icon" type="image/x-icon" href="../styles/Favicon.ico">
</head>
<body>

    <%- include("partials/navbar"); %>

<div class="profile-wrapper">

   <!-- Left Sidebar -->
<div class="profile-card">
    <div class="profile-avatar" id="avatarFrame" onclick="document.getElementById('avatarInput').click()">SB</div>
    <input type="file" id="avatarInput" accept="image/*" style="display:none" onchange="previewAvatar(event)">
    <h2>Seán Bellew</h2>
    <p class="username">@SeanB29</p>
    <p class="age">21</p>
    <button onclick="toggleEdit()">Edit Profile</button>
</div>

<!-- Main Content -->
<div class="profile-content">

        <div class="about-section">
            <h2>Interests</h2>
            <p id="bioText">
                Music Festivals, Street food, Hiking
            </p>
        </div>

        <div class="info-section">
            <h2>Information</h2>
            <p><strong>Location:</strong> Munich, Germany</p>
            <p><strong>Joined:</strong> January 2025</p>
        </div>

        <div class="activity-section">
            <h2>Travel Plans</h2>
            <ul>
                <li>Temple Bar later?</li>
              
            </ul>
        </div>

    </div>

</div>

<script>
function toggleEdit() {
    const bio = document.getElementById("bioText");

    const newBio = prompt("Edit your bio:", bio.innerText);

    if (newBio !== null) {
        bio.innerText = newBio;
    }
}

function previewAvatar(event) {
    const avatarFrame = document.getElementById("avatarFrame");
    const file = event.target.files[0]; //Limits the user to only upload 1 image
    
    if (file) {
        const reader = new FileReader(); //reads file
        reader.onload = function(e) { //after file has been uplaoded correct
            avatarFrame.style.backgroundImage = `url(${e.target.result})`;//chnaging the background image to the users file 
            avatarFrame.innerText = ""; //clears text
            avatarFrame.style.backgroundSize = "cover"; //will allow the image to fill the dimensionms
            avatarFrame.style.backgroundPosition = "center";//centres the image
        }
        reader.readAsDataURL(file);//runs 
    }
}
</script>

<%- include("partials/footer"); %>

</body>
</html>
    
