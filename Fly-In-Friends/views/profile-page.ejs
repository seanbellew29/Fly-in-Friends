<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Profile</title>
    <link rel="stylesheet" href="/styles/styles.css">
    <link rel="stylesheet" href="/styles/profile-page.css">
</head>
<body>

    <%- include("partials/navbar"); %>

<div class="profile-wrapper">

   <!-- Left Sidebar -->
<div class="profile-sidebar">
    <div class="profile-card">
        <div class="profile-avatar">SB</div>
        <h2>Seán Bellew</h2>
        <p class="username">@SeanB29</p>
        <p class="age">21</p>
        <button onclick="toggleEdit()">Edit Profile</button>
    </div>
</div>

<!-- Main Content -->
<div class="profile-content">

        <div class="about-section">
            <h2>Interests</h2>
            <p id="bioText">
                Music Festivals, Street food, Hiking
            </p>
        </div>

        <div class="info-section">
            <h2>Information</h2>
            <p><strong>Location:</strong> Munich, Germany</p>
            <p><strong>Joined:</strong> January 2025</p>
        </div>

        <div class="activity-section">
            <h2>Travel Plans</h2>
            <ul>
                <li>Temple Bar later?</li>
              
            </ul>
        </div>

    </div>

</div>

<script>
function toggleEdit() {
    const bio = document.getElementById("bioText");

    const newBio = prompt("Edit your bio:", bio.innerText);

    if (newBio !== null) {
        bio.innerText = newBio;
    }
}
</script>

<%- include("partials/footer"); %>

</body>
</html>
    
